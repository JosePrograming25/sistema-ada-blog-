---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Reportar Bug">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-8">
      <a href={base} class="text-xs text-muted-foreground hover:text-amber-400 transition-colors no-underline">← Inicio</a>
      <h1 class="text-3xl font-extrabold text-white mt-4 mb-1">Reportar un bug</h1>
      <p class="text-slate-400 text-sm">
        Tu reporte llega directamente al equipo de desarrollo. No necesitas cuenta ni registro.
      </p>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      id="bug-form"
      class="space-y-5"
    >
      <!-- Web3Forms access key — reemplazar con clave real -->
      <input type="hidden" name="access_key" value="d7446b46-bdbb-47ef-b153-cdbce32996f3" />
      <input type="hidden" name="subject" value="Bug Report — Sistema Ada" />
      <input type="hidden" name="from_name" value="Sistema Ada Blog" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <!-- Nombre (opcional) -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          Tu nombre <span class="text-muted-foreground font-normal">(opcional)</span>
        </label>
        <input
          type="text"
          name="nombre"
          placeholder="ej. Juan"
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors"
        />
      </div>

      <!-- Versión del sistema -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          Versión del sistema <span class="text-red-400">*</span>
        </label>
        <input
          type="text"
          name="version"
          required
          placeholder="ej. v1.2.0"
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors"
        />
        <p class="text-xs text-muted-foreground mt-1">La versión la ves en la parte superior del sistema, junto a la campanita.</p>
      </div>

      <!-- Dónde ocurrió -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          ¿En qué pantalla ocurrió? <span class="text-red-400">*</span>
        </label>
        <select
          name="pantalla"
          required
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors"
        >
          <option value="" disabled selected>Selecciona una pantalla...</option>
          <option>Dashboard</option>
          <option>Ventas / POS</option>
          <option>Inventario</option>
          <option>Clientes</option>
          <option>Créditos</option>
          <option>Proveedores</option>
          <option>Reportes</option>
          <option>Configuración</option>
          <option>Otra</option>
        </select>
      </div>

      <!-- Descripción -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          ¿Qué pasó? <span class="text-red-400">*</span>
        </label>
        <textarea
          name="descripcion"
          required
          rows="4"
          placeholder="Describe lo que hiciste, lo que esperabas que pasara y lo que realmente ocurrió..."
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors resize-none"
        ></textarea>
      </div>

      <!-- Nota sobre capturas -->
      <div class="p-3 bg-slate-800/50 border border-slate-700 rounded-lg">
        <p class="text-xs text-slate-400">
          💡 Si tienes una captura de pantalla, puedes describirla en el campo anterior o enviarla directamente desde la app en <strong class="text-slate-300">Ayuda → Reportar Problema</strong>.
        </p>
      </div>

      <!-- Submit -->
      <div class="pt-2">
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm transition-colors"
        >
          Enviar reporte
        </button>
      </div>

      <!-- Success / Error messages -->
      <div id="form-success" class="hidden p-4 bg-green-500/10 border border-green-500/30 rounded-lg text-green-300 text-sm text-center">
        ✅ Reporte enviado correctamente. ¡Gracias por ayudarnos a mejorar el sistema!
      </div>
      <div id="form-error" class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-lg text-red-300 text-sm text-center">
        ❌ Hubo un error al enviar. Intenta de nuevo o escríbenos directamente.
      </div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById("bug-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const successMsg = document.getElementById("form-success");
  const errorMsg = document.getElementById("form-error");

  // Form submit via fetch (Web3Forms)
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando...";
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    try {
      const data = new FormData(form);
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: data,
      });
      const json = await res.json();
      if (json.success) {
        form.reset();
        successMsg?.classList.remove("hidden");
      } else {
        errorMsg?.classList.remove("hidden");
      }
    } catch {
      errorMsg?.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar reporte";
    }
  });
</script>
