---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Reportar Bug">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-8">
      <a href={base} class="text-xs text-muted-foreground hover:text-amber-400 transition-colors no-underline">← Inicio</a>
      <h1 class="text-3xl font-extrabold text-white mt-4 mb-1">Reportar un bug</h1>
      <p class="text-slate-400 text-sm">
        Tu reporte llega directamente al equipo de desarrollo. No necesitas cuenta ni registro.
      </p>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      id="bug-form"
      class="space-y-5"
    >
      <!-- Web3Forms access key — reemplazar con clave real -->
      <input type="hidden" name="access_key" value="d7446b46-bdbb-47ef-b153-cdbce32996f3" />
      <input type="hidden" name="subject" value="Bug Report — Sistema Ada" />
      <input type="hidden" name="from_name" value="Sistema Ada Blog" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <!-- Nombre (opcional) -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          Tu nombre <span class="text-muted-foreground font-normal">(opcional)</span>
        </label>
        <input
          type="text"
          name="nombre"
          placeholder="ej. Juan"
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors"
        />
      </div>

      <!-- Versión del sistema -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          Versión del sistema <span class="text-red-400">*</span>
        </label>
        <input
          type="text"
          name="version"
          required
          placeholder="ej. v1.2.0"
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors"
        />
        <p class="text-xs text-muted-foreground mt-1">La versión la ves en la parte superior del sistema, junto a la campanita.</p>
      </div>

      <!-- Dónde ocurrió -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          ¿En qué pantalla ocurrió? <span class="text-red-400">*</span>
        </label>
        <select
          name="pantalla"
          required
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors"
        >
          <option value="" disabled selected>Selecciona una pantalla...</option>
          <option>Dashboard</option>
          <option>Ventas / POS</option>
          <option>Inventario</option>
          <option>Clientes</option>
          <option>Créditos</option>
          <option>Proveedores</option>
          <option>Reportes</option>
          <option>Configuración</option>
          <option>Otra</option>
        </select>
      </div>

      <!-- Descripción -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          ¿Qué pasó? <span class="text-red-400">*</span>
        </label>
        <textarea
          name="descripcion"
          required
          rows="4"
          placeholder="Describe lo que hiciste, lo que esperabas que pasara y lo que realmente ocurrió..."
          class="w-full bg-card border border-border rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/30 transition-colors resize-none"
        ></textarea>
      </div>

      <!-- Captura de pantalla -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">
          Captura de pantalla <span class="text-muted-foreground font-normal">(opcional)</span>
        </label>
        <label
          id="drop-zone"
          class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-border hover:border-amber-500/50 rounded-xl p-6 cursor-pointer transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-sm text-slate-400" id="drop-label">Arrastra una imagen o haz clic para subir</span>
          <span class="text-xs text-muted-foreground">PNG, JPG, WEBP — máx. 10 MB</span>
          <input type="file" accept="image/*" class="hidden" id="file-input" />
        </label>
        <div id="preview" class="mt-3 hidden">
          <img id="preview-img" src="" alt="Preview" class="max-h-40 rounded-lg border border-border" />
          <button type="button" id="remove-img" class="mt-1 text-xs text-red-400 hover:text-red-300">✕ Quitar imagen</button>
        </div>
        <!-- URL generada por Cloudinary (se llena automáticamente) -->
        <input type="hidden" name="captura_url" id="captura-url" />
      </div>

      <!-- Submit -->
      <div class="pt-2">
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm transition-colors"
        >
          Enviar reporte
        </button>
      </div>

      <!-- Success / Error messages -->
      <div id="form-success" class="hidden p-4 bg-green-500/10 border border-green-500/30 rounded-lg text-green-300 text-sm text-center">
        ✅ Reporte enviado correctamente. ¡Gracias por ayudarnos a mejorar el sistema!
      </div>
      <div id="form-error" class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-lg text-red-300 text-sm text-center">
        ❌ Hubo un error al enviar. Intenta de nuevo o escríbenos directamente.
      </div>
    </form>
  </div>
</Layout>

<script>
  const CLOUDINARY_CLOUD = "de2trmels";
  const CLOUDINARY_PRESET = "ml_default";
  const DISCORD_WEBHOOK = "https://discordapp.com/api/webhooks/1486536160858607626/9d7JbdFxsgVhcUwmUMI9j96fc-kEDGk4PiqAJ1lrgj_wfZ-VhOpDb4UA7ovAQciH-vNs";

  const form = document.getElementById("bug-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const successMsg = document.getElementById("form-success");
  const errorMsg = document.getElementById("form-error");
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const dropZone = document.getElementById("drop-zone");
  const dropLabel = document.getElementById("drop-label");
  const preview = document.getElementById("preview");
  const previewImg = document.getElementById("preview-img") as HTMLImageElement;
  const removeBtn = document.getElementById("remove-img");
  const capturaUrl = document.getElementById("captura-url") as HTMLInputElement;

  let selectedFile: File | null = null;

  function setFile(file: File) {
    selectedFile = file;
    previewImg.src = URL.createObjectURL(file);
    preview?.classList.remove("hidden");
    if (dropLabel) dropLabel.textContent = file.name;
  }

  function clearFile() {
    selectedFile = null;
    fileInput.value = "";
    preview?.classList.add("hidden");
    previewImg.src = "";
    if (dropLabel) dropLabel.textContent = "Arrastra una imagen o haz clic para subir";
    capturaUrl.value = "";
  }

  fileInput?.addEventListener("change", () => {
    if (fileInput.files?.[0]) setFile(fileInput.files[0]);
  });

  removeBtn?.addEventListener("click", clearFile);

  dropZone?.addEventListener("dragover", (e) => { e.preventDefault(); dropZone.classList.add("border-amber-500/50"); });
  dropZone?.addEventListener("dragleave", () => { dropZone.classList.remove("border-amber-500/50"); });
  dropZone?.addEventListener("drop", (e: DragEvent) => {
    e.preventDefault();
    dropZone.classList.remove("border-amber-500/50");
    const file = e.dataTransfer?.files?.[0];
    if (file?.type.startsWith("image/")) setFile(file);
  });

  async function uploadToCloudinary(file: File): Promise<string> {
    const fd = new FormData();
    fd.append("file", file);
    fd.append("upload_preset", CLOUDINARY_PRESET);
    const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD}/image/upload`, {
      method: "POST",
      body: fd,
    });
    const json = await res.json();
    if (!res.ok || !json.secure_url) {
      const msg = json?.error?.message || "Error al subir imagen a Cloudinary";
      throw new Error(msg);
    }
    return json.secure_url;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando...";
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    try {
      // Si hay imagen, subirla a Cloudinary primero
      if (selectedFile) {
        submitBtn.textContent = "Subiendo imagen...";
        try {
          const url = await uploadToCloudinary(selectedFile);
          capturaUrl.value = url;
        } catch (imgErr: any) {
          // Imagen falló — continuar sin ella pero avisar
          console.warn("Cloudinary upload failed:", imgErr.message);
          capturaUrl.value = "";
          // Mostrar advertencia no bloqueante
          const warn = document.createElement("p");
          warn.className = "text-xs text-amber-400 mt-1";
          warn.textContent = `⚠ Imagen no adjuntada: ${imgErr.message}`;
          document.getElementById("preview")?.after(warn);
          setTimeout(() => warn.remove(), 8000);
        }
      }

      const data = new FormData(form);
      // Si hay URL de captura, incluirla en la descripción también
      if (capturaUrl.value) {
        const desc = data.get("descripcion") as string;
        data.set("descripcion", `${desc}\n\n📸 Captura: ${capturaUrl.value}`);
      }

      submitBtn.textContent = "Enviando reporte...";

      const nombre    = (data.get("nombre") as string)     || "Anónimo";
      const version   = (data.get("version") as string)    || "—";
      const pantalla  = (data.get("pantalla") as string)   || "—";
      const descripcion = (data.get("descripcion") as string) || "—";
      const imgUrl    = capturaUrl.value;

      // Enviar a Web3Forms (email) y Discord en paralelo
      const [web3res] = await Promise.all([
        fetch("https://api.web3forms.com/submit", { method: "POST", body: data }),
        fetch(DISCORD_WEBHOOK, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            embeds: [{
              title: "🐛 Bug Report — Sistema Ada",
              color: 0xf59e0b,
              fields: [
                { name: "👤 Usuario",   value: nombre,     inline: true },
                { name: "🔖 Versión",   value: version,    inline: true },
                { name: "📋 Pantalla",  value: pantalla,   inline: true },
                { name: "📝 Descripción", value: descripcion },
                ...(imgUrl ? [{ name: "📸 Captura", value: imgUrl }] : []),
              ],
              timestamp: new Date().toISOString(),
              footer: { text: "Sistema Ada Blog" },
            }],
          }),
        }),
      ]);

      const web3json = await web3res.json();
      if (web3json.success) {
        form.reset();
        clearFile();
        successMsg?.classList.remove("hidden");
      } else {
        errorMsg?.classList.remove("hidden");
      }
    } catch (err: any) {
      const msgEl = errorMsg as HTMLElement | null;
      if (msgEl) {
        msgEl.textContent = `❌ ${err?.message || "Hubo un error al enviar. Intenta de nuevo o escríbenos directamente."}`;
        msgEl.classList.remove("hidden");
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar reporte";
    }
  });
</script>
